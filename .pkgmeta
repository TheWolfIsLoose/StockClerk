# Stock Clerk - BigWigsMods packager config.
# Used by .github/workflows/release.yml and by CurseForge's own packager.
# Release process: see "Releasing" in README.md.

package-as: StockClerk

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Stripped from the packaged zip. Keep comments on their own lines: an
# inline `# ...` after an entry silently breaks that entry.
ignore:
  - README.md
  - Dev
  - .assets
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
