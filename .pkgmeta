# Stock Clerk - BigWigsMods packager config
# https://github.com/BigWigsMods/packager
#
# When we wire up release.sh / GitHub Actions, this file drives what
# ships to CurseForge / Wago / WoWInterface. Files listed under
# `ignore` are stripped from the packaged zip.

package-as: StockClerk

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Dev-only files that must never appear in packaged releases.
# Comments MUST be on their own line here — inline `# ...` after a list
# entry silently breaks the ignore rule for that entry in the BigWigsMods
# packager, which is why an earlier dry-run leaked update.bat / Dev / README.
ignore:
  - update.bat
  - README.md
  - Dev
  - .github
  - .gitignore
  - .pkgmeta
